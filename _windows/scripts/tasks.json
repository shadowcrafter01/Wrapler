{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g", // for step by step debugging
                //"-v", // verbose debugging
                //"-O3", // optimize (bad for debugging)
                //"-mwindows", // build with no console

                "-o", "out.exe",

                "src/*.cpp",
                //"libs/*.cpp",
                
                "-I", "${workspaceFolder}",
                "-I", "${workspaceFolder}/include",
                "-I", "${workspaceFolder}/libs",
                "-I", "${workspaceFolder}/libs/ENG",
                "-I", "${workspaceFolder}/libs/SDL/include",
                "-I", "${workspaceFolder}/libs/SDL_mixer/include",
                "-I", "${workspaceFolder}/libs/SDL_image/include",
                "-I", "${workspaceFolder}/libs/SDL_net/include",
                "-I", "${workspaceFolder}/libs/SDL_ttf/include",

                "SDL3.dll",
                "SDL3_mixer.dll",
                "SDL3_image.dll",
                "SDL3_net.dll",
                "SDL3_ttf.dll",
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}